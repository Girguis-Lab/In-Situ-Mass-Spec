            "frameParserCode": "/**\n * Key-Value Pairs Parser (modified for ISMS output)\n *\n * Parses key-value formatted data into an array of values using a custom keymap.\n *\n * INPUT FORMAT: \"temperature=22.5,humidity=60.3,pressure=1013\"\n * OUTPUT ARRAY: [22.5, 60.3, 1013]\n *\n * Note: Frame delimiters are automatically removed by Serial Studio.\n *       Values are mapped to array indices based on the keyToIndexMap.\n *       Missing keys retain their previous values between frames.\n */\n\n//------------------------------------------------------------------------------\n// Configuration\n//------------------------------------------------------------------------------\n\n/**\n * Maps key names to array indices.\n * Customize this object to match your data format and desired output order.\n */\n //Fluidpump_Rate:0(!),Turbo_RPM_Setpoint:90000,Turbo_RPM:90018,Turbo_Current:0.32A,Turbo_Rotor_Temp:53C,\n //Turbo_Elec_Temp:35C,Turbo_Bottom_Temp:31C,Roughing_on:0,Fluidpump_on:0,pH_on:0,\nconst keyToIndexMap = {\n  Fluidpump_Rate:0,\n  Turbo_RPM_Setpoint: 1,\n  Turbo_RPM: 2,\n  Turbo_Current: 3,\n  Turbo_Rotor_Temp:4,\n  Turbo_Elec_Temp:5,\n  Turbo_Bottom_Temp:6,\n  Roughing_on:7,\n  Fluidpump_on:8,\n  Cryo_on:9,\n  Warn: 10\n};\n\n// Keep track of where the warnings start in the list of comma separated items.\nWARNINGS_INDEX_BEGIN = keyToIndexMap[\"Warn\"]\n\n\n/**\n * Array to hold parsed values with default initialization.\n * Values persist between frames unless updated by incoming data.\n */\nconst parsedValues = new Array(Object.keys(keyToIndexMap).length + 10);\nparsedValues.fill(0,0,Object.keys(keyToIndexMap).length);\nparsedValues.fill(\"\",Object.keys(keyToIndexMap).length,100);\n\n// fill warnings section with spaces\nfor (let i = WARNINGS_INDEX_BEGIN; i < parsedValues.length; i++) {\n     parsedValues[i] = \" \"\n}\n\n//------------------------------------------------------------------------------\n// Frame Parser Function\n//------------------------------------------------------------------------------\n\n/**\n * Parses a key-value frame into an array of values.\n *\n * @param {string} frame - The key-value data from the data source\n * @returns {array} Array of values mapped according to keyToIndexMap\n */\nfunction parse(frame) {\n if(frame.startsWith(\"!WARN:\")){\n     // clear old warnings\n      for (let i = WARNINGS_INDEX_BEGIN; i < parsedValues.length; i++) {\n          parsedValues[i] = \" \"\n      }\n     // fill in the end of the table with any warnings\n     let warningsText = frame.substring(7)\n     let warningsArray = warningsText.split(\",\");\n     for (let i = 0; i < warningsArray.length; i++) {\n         parsedValues[WARNINGS_INDEX_BEGIN + i] = warningsArray[i];\n     }\n } else if(frame.startsWith(\"|\")  || frame.startsWith(\"[\") || frame.startsWith(\"->\") || frame.startsWith(\"<-\")) {\n  // for other info lines, ignore them\n  return [];\n } else {\n  const regex = /([\\w]+):([-\\d.]+)/g;\n  let match;\n  while ((match = regex.exec(frame)) !== null) {\n    const key = match[1];\n    const value = parseFloat(match[2]);\n\n    if (keyToIndexMap.hasOwnProperty(key))\n      parsedValues[keyToIndexMap[key]] = value;\n  }\n\n  \n}\n  return parsedValues;\n}\n",
            "frameStart": "$",
            "hexadecimalDelimiters": false,
            "sourceId": 0,
            "title": "Device A"
        }
    ],
