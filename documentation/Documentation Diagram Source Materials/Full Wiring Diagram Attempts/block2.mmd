%% ===== Main Enclosure (RGA + Turbo Pump + Roughing Pump + Main PCB groups, plus SubConn 16-pin) =====
subgraph mainEnclosure ["Main Enclosure"]
    direction LR

    mainPCB("Main PCB")

    subgraph roughingPumpGroup ["Roughing Pump"]
        db9RP(["DB9 (with autostart jumpers)"])
        roughingPump("ROUGHING PUMP (24v)")
    end

    subgraph turboPumpGroup ["Turbo Pump"]
        db15(["DB15"])
        turboPump("TURBO PUMP (24v)")
    end

    subgraph rgaGroup ["RGA"]
        barrelJack(["Barrel Jack"])
        db9RGA(["DB9 (with fake RS232 handshake jumpers)"])
        rgaDevice("RGA (24v)")
    end

end

%% ===== Topside (everything linked directly to the Topside connection, except SubConn 8-pin) =====
subgraph topsideGroup ["Topside"]
    direction LR
    subgraph topside ["Topside connection"]
        direction LR
        topside_1(("1"))
        topside_2(("2"))
        topside_3(("3"))
        topside_4(("4"))
        topside_5(("5"))
        topside_6(("6"))
        topside_7(("7"))
        topside_8(("8"))
    end
    rgaCommsDb9(["RGA COMMS DB9 (with fake RS232 handshake jumpers)"])
    ismsDb9(["ISMS COMMS DB9"])
    usbIsms(["USB to RS232 (to ISMS COMMS DB9)"])
    usbRga(["USB to RS232 (to RGA COMMS DB9)"])
    psA("POWER SUPPLY A (24-48v @ 4A)")
    psB("POWER SUPPLY B (24-48v @ 4A)")
    laptop("LAPTOP")
end


